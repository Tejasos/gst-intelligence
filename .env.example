# Application Environment (development | production)
APP_ENV=production

# Server Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key

# Persistent Storage Paths (Ensure these reside on a persistent/mounted disk)
DATA_DIR=/app/data
DATABASE_PATH=/app/data/gst_intelligence.db
UPLOAD_DIR=/app/data/uploads
OUTPUT_DIR=/app/data/output
BACKUP_DIR=/app/data/backups

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-app.onrender.com

# Authentication & Session Settings
AUTH_REQUIRED=true
SESSION_EXPIRY_HOURS=72

# AI Inference Provider ('ollama' or 'hosted')
AI_PROVIDER=ollama

# Ollama Settings (used if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=120

# Hosted AI Provider (used if AI_PROVIDER=hosted - compatible with OpenAI, Groq, Together, etc.)
HOSTED_AI_BASE_URL=https://api.openai.com/v1
HOSTED_AI_API_KEY=your-hosted-ai-api-key-here
HOSTED_AI_MODEL=gpt-4o-mini
HOSTED_AI_TIMEOUT=60

# Max Upload Size in Megabytes
MAX_UPLOAD_MB=50
